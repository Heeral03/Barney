GROQ_API_KEY=
SERPKITE_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   (other models on this key: openai/gpt-oss-20b, qwen/qwen3.8-27b)
# Postgres for LangGraph checkpoints and long-term memory (docker compose up -d postgres)
DATABASE_URL=postgresql://lily:lily@localhost:5433/lily
# Web-search fallback (https://tavily.com)
TAVILY_API_KEY=
# Primary product search (https://serpapi.com): Google Shopping with per-store prices
SERPAPI_API_KEY=

# Extra genuine stores, as domain:countries (countries separated by |, or * for worldwide). Optional.
# EXTRA_STORES=shop.example.com:IN|US,other.example:*
# Run `python -m app.worker` as its own process for price checks and the "Barney noticed" feed, and set ALERTS=off on the web server.
# WORKER_INTERVAL_MINUTES=360
