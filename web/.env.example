# Copy to .env.local and fill in. Never commit .env.local.

# Where the Barney back end (FastAPI) runs.
BARNEY_API=http://127.0.0.1:8000

# Auth.js session secret:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google sign-in: https://console.cloud.google.com/apis/credentials  ->  Create credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origin:   http://localhost:3000
#   Authorised redirect URI:        http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared with the back end (the same value in its .env). At least 32 characters:  openssl rand -base64 48
BACKEND_JWT_SECRET=
